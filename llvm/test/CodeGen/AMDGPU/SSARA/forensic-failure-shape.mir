# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-ssa-register-allocator \
# RUN:   -amdgpu-ssa-experiment-bail \
# RUN:   -amdgpu-ssa-forensic-json=%t.json -o /dev/null %s
# RUN: FileCheck %s --input-file=%t.json
#
# Failure shape (Test 3): more simultaneously-live SGPR_32 values than the
# allocatable pool forces coloring failures. The reporter records each as an
# attempt-failed event (with the failure reason and the full liveSet
# cross-section) plus a colorfail-spill-across snapshot carrying the fact-only
# live-through / no-interior-use tallies. -amdgpu-ssa-experiment-bail keeps the
# run from entering the (WIP) spill path so the forensic record flushes cleanly.
#
# The failed attempt carries the failure reason, its liveSet, and links to the
# colorfail-spill-across snapshot's fact tallies.
# CHECK: "kind":"attempt-failed"
# CHECK-SAME: "reason":"no-free-physreg-across-range"
# CHECK-SAME: "liveSet":[
# CHECK: "tag":"colorfail-spill-across"
# CHECK-SAME: "liveThrough":
# CHECK-SAME: "noInteriorUse":
# CHECK: "kind":"run-completed"

--- |
  define amdgpu_kernel void @forensic_failure_shape() { ret void }
...
---
name:            forensic_failure_shape
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: sgpr_32 }
  - { id: 1, class: sgpr_32 }
